{
  "name": "@scoful/version-up",
  "version": "0.1.5",
  "description": "Automated semantic versioning with native Git hooks for multi-language projects",
  "type": "module",
  "main": "bin/version-up.js",
  "bin": {
    "version-up": "./bin/version-up.js"
  },
  "scripts": {
    "check": "node bin/version-up.js show",
    "release": "npm publish",
    "release:minor": "node bin/version-up.js minor && npm publish",
    "release:major": "node bin/version-up.js major && npm publish"
  },
  "keywords": [
    "version",
    "versioning",
    "semver",
    "semantic-versioning",
    "git-hooks",
    "pre-commit",
    "post-commit",
    "automation",
    "ci-cd",
    "github-actions",
    "multi-language",
    "version-bump",
    "release-management",
    "changelog"
  ],
  "author": "scoful",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/scoful/version-up.git"
  },
  "homepage": "https://github.com/scoful/version-up#readme",
  "bugs": {
    "url": "https://github.com/scoful/version-up/issues"
  },
  "engines": {
    "node": ">=16.0.0"
  },
  "files": [
    "bin/",
    "core/",
    "templates/",
    "README.md",
    "README-EN.md"
  ],
  "dependencies": {
    "@iarna/toml": "^2.2.5",
    "chalk": "^4.1.2",
    "inquirer": "^9.2.0"
  }
}
